# ─────────────────────────────────────────────────────────────
# PLATAFORMA VELS — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas configurações
# ─────────────────────────────────────────────────────────────

# Chave secreta de sessão do Flask
SECRET_KEY=vels-chave-secreta-desenvolvimento-ufpi-2026

# Banco de Dados
# Em desenvolvimento local: Deixe em branco para usar SQLite local em instance/vels.db
# Em produção (Supabase / PostgreSQL):
# DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres
DATABASE_URL=

# Integração de IA do Espaço Suriel (Opcional - possui fallback local resiliente)
# Google Gemini API Key
GEMINI_API_KEY=
# Anthropic API Key (Claude)
ANTHROPIC_API_KEY=

# Supabase (Opcional caso utilize autenticação/storage externo)
SUPABASE_URL=
SUPABASE_KEY=

# Modo de Depuração
FLASK_DEBUG=true
